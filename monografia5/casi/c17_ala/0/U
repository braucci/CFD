FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// corrente a 5 gradi di incidenza, |U| = 1
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0.9961947 0.08715574 0);
boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"      // tipi dei patch vincolati (processor, symmetryPlane...) in parallelo
    ingresso    { type fixedValue;     value $internalField; }
    uscita      { type inletOutlet;    inletValue $internalField; value $internalField; }
    lati        { type freestreamVelocity; freestreamValue $internalField; }
    simmetria   { type symmetryPlane; }
    ala         { type noSlip; }
}
