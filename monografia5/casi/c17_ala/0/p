FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"      // tipi dei patch vincolati (processor, symmetryPlane...) in parallelo
    ingresso    { type zeroGradient; }
    uscita      { type fixedValue;     value uniform 0; }
    lati        { type freestreamPressure; freestreamValue $internalField; }
    simmetria   { type symmetryPlane; }
    ala         { type zeroGradient; }
}
