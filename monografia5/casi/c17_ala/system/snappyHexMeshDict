FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// snappyHexMesh in tre fasi: castellamento (raffinamento e scavo), snap (adattamento alla superficie), strati a parete.
castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    ala                                     // la superficie STL scritta da codice/wingstl.py
    {
        type triSurfaceMesh;
        file "ala.stl";
    }
    scatolaScia                             // regione di raffinamento intorno all'ala e nella scia
    {
        type searchableBox;
        min (-0.5 -0.6 0);
        max ( 3.0  0.6 2.4);
    }
}

castellatedMeshControls
{
    maxLocalCells       500000;
    maxGlobalCells      1500000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;                  // celle di transizione fra due livelli (2:1 piu' graduale)

    features                                // spigoli vivi (bordo d'uscita, tip) dal file eMesh di surfaceFeatures
    (
        { file "ala.eMesh"; level 6; }
    );

    refinementSurfaces
    {
        ala
        {
            level (5 6);                    // 0,5/2^5 = 0,016 c sulla superficie, 0,008 c dove la curvatura e' alta
            patchInfo { type wall; }
        }
    }
    resolveFeatureAngle 30;

    refinementRegions
    {
        scatolaScia { mode inside; level 3; }                          // 0,06 c nella scatola
        ala         { mode distance; levels ((0.05 5) (0.2 4)); }      // 0,016 c entro 0,05 c dall'ala, 0,03 c entro 0,2 c
    }

    insidePoint (-3 0 3);                   // un punto nel fluido: si tiene la regione che lo contiene
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          30;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;               // spessori relativi alla cella di superficie
    layers
    {
        ala { nSurfaceLayers 4; }
    }
    expansionRatio      1.3;
    finalLayerThickness 0.4;                // l'ultimo strato e' il 40% della cella adiacente
    minThickness        0.05;
    nGrow               0;
    featureAngle        110;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedianAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    #include "meshQualityDict"
}

writeFlags ( scalarLevels layerSets layerFields );
mergeTolerance 1e-6;
