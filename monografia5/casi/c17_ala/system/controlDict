FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     foamRun;
solver          incompressibleFluid;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1000;
deltaT          1;
writeControl    timeStep;
writeInterval   500;
purgeWrite      1;
writeFormat     ascii;
writePrecision  7;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    coefficienti
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        log             no;
        patches         (ala);
        rho             rhoInf;
        rhoInf          1;
        liftDir         (-0.08715574 0.9961947 0);     // alfa = 5 gradi: perpendicolare alla corrente
        dragDir         ( 0.9961947 0.08715574 0);
        CofR            (0.25 0 0);
        pitchAxis       (0 0 1);
        magUInf         1;
        lRef            1;                              // corda
        Aref            2;                              // superficie della semiala (corda x semiapertura)
    }
    #includeFunc yPlus
}
