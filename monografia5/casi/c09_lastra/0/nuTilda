FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}
// Spalart-Allmaras: nuTilda = 3 nu in corrente libera
dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 3e-7;
boundaryField
{
    ingresso    { type fixedValue; value uniform 3e-7; }
    uscita      { type inletOutlet; inletValue uniform 3e-7; value uniform 3e-7; }
    sopra       { type slip; }
    simmetria   { type symmetryPlane; }
    lastra      { type fixedValue; value uniform 0; }
    frontEretro { type empty; }
}
