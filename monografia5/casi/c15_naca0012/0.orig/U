FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// corrente asintotica unitaria; l'incidenza e' data ruotando il vettore (lo script genera.py)
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (1 0 0);
boundaryField
{
    esterno     { type freestreamVelocity; freestreamValue $internalField; }   // ingresso o uscita secondo il flusso locale
    profilo     { type noSlip; }
    frontEretro { type empty; }
}
