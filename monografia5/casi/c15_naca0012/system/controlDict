FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         4000;

deltaT          1;

writeControl    timeStep;

writeInterval   4000;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    #include        "forzeDict"
    #includeFunc    yPlus
    #includeFunc    wallShearStress(patches=(profilo))
}


