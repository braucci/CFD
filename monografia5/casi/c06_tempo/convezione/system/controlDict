FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     foamRun;
solver          functions;
subSolver       incompressibleFluid;
subSolverTime   0;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         5;
deltaT          0.1;         // = Co * dx, sostituito dallo script
writeControl    runTime;
writeInterval   5;
writeFormat     ascii;
writePrecision  10;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;
functions
{
    #includeFunc scalarTransport(s, diffusivity=none)
}
