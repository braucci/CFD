FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    s       { solver PBiCGStab; preconditioner DILU; tolerance 1e-12; relTol 0; }
    "(p|U)" { solver PCG; preconditioner DIC; tolerance 1e-6; relTol 0; }
}
PIMPLE { nCorrectors 1; nNonOrthogonalCorrectors 0; pRefCell 0; pRefValue 0; }
