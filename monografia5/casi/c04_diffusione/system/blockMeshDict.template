FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// parallelogramma: x -> x + S*y (S = 0 quadrato; 0.5 e 1 mesh distorte); N x N celle
convertToMeters 1;

vertices
(
    (0 0 0) (1 0 0) (__X2__ 1 0) (__X3__ 1 0)
    (0 0 0.1) (1 0 0.1) (__X2__ 1 0.1) (__X3__ 1 0.1)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (__N__ __N__ 1) simpleGrading (1 1 1)
);

edges ();

boundary
(
    contorno    { type patch; faces ((0 4 7 3) (1 2 6 5) (0 1 5 4) (3 7 6 2)); }
    frontEretro { type empty; faces ((0 3 2 1) (4 5 6 7)); }
);

mergePatchPairs ();
