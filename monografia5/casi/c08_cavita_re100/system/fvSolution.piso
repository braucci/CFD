FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// variante transitoria (PISO): nessun rilassamento, due correttori di pressione per passo
solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-08;
        relTol          0.05;
    }
    pFinal
    {
        $p;
        relTol          0;              // l'ultimo correttore del passo e' risolto fino a tolleranza assoluta
    }
    "U.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0;
    }
}

PIMPLE
{
    nCorrectors     2;                  // PISO: un'iterazione esterna, due correttori di pressione
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}
