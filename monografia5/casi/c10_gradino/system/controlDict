FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
application     foamRun;
solver          incompressibleFluid;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         4000;
deltaT          1;
writeControl    timeStep;
writeInterval   1000;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    #includeFunc wallShearStress(patches=(fondo monte))     // scrive il campo wallShearStress all'istante di scrittura
    #includeFunc yPlus                                 // y+ nella prima cella di ogni parete
}
