FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// k = 1,5 (U I)^2 con U = 44,2 m/s, I = 1%: 0,293 m^2/s^2
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0.293;
boundaryField
{
    ingresso    { type fixedValue; value uniform 0.293; }
    uscita      { type inletOutlet; inletValue uniform 0.293; value uniform 0.293; }
    sopra       { type kqRWallFunction; value uniform 0.293; }
    monte       { type kqRWallFunction; value uniform 0.293; }
    gradino     { type kqRWallFunction; value uniform 0.293; }
    fondo       { type kqRWallFunction; value uniform 0.293; }   // gradiente nullo (con e senza funzioni di parete)
    frontEretro { type empty; }
}
