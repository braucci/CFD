#!/bin/bash
# Caso c14_codice: rimuove gli oggetti di compilazione e i risultati dei due casi di prova
cd "${0%/*}" || exit 1
(cd profiloParabolico && wclean) > /dev/null 2>&1
(cd trasportoFoam && wclean) > /dev/null 2>&1
rm -rf profiloParabolico/lnInclude profiloParabolico/Make/linux64* trasportoFoam/Make/linux64*
rm -f log.wmake_profiloParabolico log.wmake_trasportoFoam
rm -rf casoTrasporto/constant/polyMesh casoTrasporto/postProcessing casoTrasporto/log.blockMesh casoTrasporto/log.trasportoFoam
rm -rf casoProfilo/constant/polyMesh casoProfilo/postProcessing casoProfilo/log.blockMesh casoProfilo/log.foamRun
for d in casoTrasporto casoProfilo; do
    find "$d" -maxdepth 1 -type d -regex '.*/[0-9]+\(\.[0-9]+\)?' ! -name 0 -exec rm -rf {} +
done
