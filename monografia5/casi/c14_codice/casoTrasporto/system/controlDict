FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// Caso di prova per trasportoFoam: lo stesso gradino obliquo del caso c05_convezione, con il campo U
// assegnato in 0/U e tenuto fisso; il risultato deve coincidere con quello della function object scalarTransport.

application     trasportoFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1500;           // iterazioni massime (ddtSchemes steadyState)
deltaT          1;
writeControl    timeStep;
writeInterval   1500;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

